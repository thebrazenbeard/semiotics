{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semiotics Registry v0.1",
  "type": "object",
  "required": ["signs", "sources", "interpretations"],
  "additionalProperties": false,
  "properties": {
    "signs": {"type": "array", "items": {"$ref": "#/$defs/sign"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "interpretations": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}}
  },
  "$defs": {
    "sign": {"type": "object", "additionalProperties": false, "required": ["id", "form", "modality"], "properties": {"id": {"type": "string", "minLength": 1}, "form": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "locator": {"type": "string"}, "evidence_class": {"type": "string", "minLength": 1}}},
    "interpretation": {"type": "object", "additionalProperties": false, "required": ["id", "sign_id", "meaning", "source_id"], "properties": {"id": {"type": "string", "minLength": 1}, "sign_id": {"type": "string", "minLength": 1}, "meaning": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "required_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "excluded_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "status": {"enum": ["candidate", "supported", "unresolved", "rejected"]}, "theory_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "support": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "scope": {"type": "string"}}}
  }
}
